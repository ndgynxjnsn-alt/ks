{
  "realm": "lgtm",
  "enabled": true,
  "displayName": "LGTM observability",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
{% for r in keycloak_realm_roles %}
      { "name": "{{ r }}" }{{ '' if loop.last else ',' }}
{% endfor %}
    ]
  },
  "clients": [
    {
      "clientId": "{{ oauth.client_id }}",
      "name": "Grafana",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "{{ oauth_client_secret }}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "https://grafana.{{ domain }}",
      "redirectUris": [
        "https://grafana.{{ domain }}/login/generic_oauth",
        "http://grafana.{{ domain }}/login/generic_oauth"
      ],
      "webOrigins": ["https://grafana.{{ domain }}", "http://grafana.{{ domain }}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://grafana.{{ domain }}/login##http://grafana.{{ domain }}/login"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "{{ oauth.roles_claim }}",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "{{ oauth.argocd_client_id }}",
      "name": "Argo CD",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "{{ argocd_oauth_client_secret }}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "rootUrl": "https://argocd.{{ domain }}",
      "redirectUris": ["https://argocd.{{ domain }}/auth/callback"],
      "webOrigins": ["https://argocd.{{ domain }}"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://argocd.{{ domain }}/login"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "{{ oauth.roles_claim }}",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
{% for u in keycloak_users %}
    {
      "username": "{{ u.name }}",
      "email": "{{ u.email }}",
      "emailVerified": true,
      "firstName": "{{ u.name | capitalize }}",
      "lastName": "Lab",
      "enabled": true,
      "realmRoles": {{ u.roles | to_json }},
      "credentials": [
        { "type": "password", "temporary": false,
          "value": "{{ lookup('password', secrets_dir + '/keycloak_user_' + u.name + ' chars=ascii_letters,digits length=16') }}" }
      ]
    }{{ '' if loop.last else ',' }}
{% endfor %}
  ]
}
