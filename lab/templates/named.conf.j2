// {{ ansible_managed }}
// LAB: authoritative DNS for {{ domain }} (no recursion): *.{{ domain }} -> ingress VIP. Pebble resolves the
// hostnames here to validate HTTP-01 challenges; use it from the host too (port 10053).
options {
  directory "/var/cache/bind";
  listen-on { any; };
  listen-on-v6 { none; };
  recursion no;
  allow-query { any; };
  dnssec-validation no;
};

zone "{{ domain }}" {
  type primary;
  file "/var/lib/bind/{{ domain }}.zone";
};
