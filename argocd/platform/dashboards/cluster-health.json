    {
      "type": "table",
      "title": "Restarting containers (last 6h)",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          },
          "expr": "sort_desc(increase(kube_pod_container_status_restarts_total[6h]) > 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "node": true,
              "uid": true
            },
            "renameByName": {
              "Value": "restarts"
            }
          }
        }
      ],
      "id": 16,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 7
