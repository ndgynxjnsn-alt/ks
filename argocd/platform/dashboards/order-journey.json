{
  "uid": "order-journey",
  "title": "Order journey — follow a business id",
  "schemaVersion": 41,
  "version": 1,
  "tags": [
    "examples"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "description": "Follow one order (order.id) through browser, backends and database. examples/README.md",
  "templating": {
    "list": [
      {
        "name": "order_id",
        "label": "Order id",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Paste an **order id** above (from the shop page, or from *Recent orders* below). Traces: click a trace id to open it (browser → shop → stock/pricing → catalog → PostgreSQL). Logs: every line that carries the id; a log line with a trace id links back to its trace."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Traces of this order",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "tableType": "traces",
          "limit": 20,
          "query": "{ span.order.id = \"$order_id\" }"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Backend and database logs of this order",
      "description": "OTLP log attribute order.id (backends: MDC; PostgreSQL: application_name) = structured metadata order_id",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\".+\"} | order_id=\"$order_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Browser (Faro) logs and events of this order",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{app_name=\"shop-frontend\"} |= \"$order_id\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Slow queries (PostgreSQL, ≥ 1 s)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"postgresql\"} |= \"duration:\"",
          "queryType": "range"
        }
      ]
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Recent orders",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"shop\"} |= \"order placed\" | order_id=~\".+\" | line_format \"{{.order_id}}  {{__line__}}\"",
          "queryType": "range"
        }
      ]
    }
  ]
}