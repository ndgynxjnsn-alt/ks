{{- /*
Grafana datasources of one organization, as a YAML list (provisioning file: Grafana expands $VAR there, so a
literal $ is written $$).
  orgId:   the Grafana organization
  tenants: tenants the org may see (header "a|b" = cross-tenant query)
Cross-links: metric exemplar -> trace · trace -> logs / metrics / CPU profile of the span · log -> trace
*/ -}}
{{- define "lgtm.datasources" -}}
{{- $org := .orgId -}}
{{- $header := join "|" .tenants -}}
- name: Mimir
  uid: mimir
  orgId: {{ $org }}
  type: prometheus
  access: proxy
  url: http://mimir-monolithic.lgtm.svc:8080/prometheus
  isDefault: true
  jsonData:
    prometheusType: Mimir
    httpMethod: POST
    manageAlerts: false
    httpHeaderName1: X-Scope-OrgID
    # exemplars carry the trace_id of a request that was counted -> click the diamond to open the trace
    exemplarTraceIdDestinations:
      - { name: trace_id, datasourceUid: tempo, urlDisplayLabel: View trace }
  secureJsonData:
    httpHeaderValue1: {{ $header | quote }}

- name: Loki
  uid: loki
  orgId: {{ $org }}
  type: loki
  access: proxy
  url: http://loki.lgtm.svc:3100
  jsonData:
    httpHeaderName1: X-Scope-OrgID
    # trace_id arrives as OTLP structured metadata -> link it to Tempo
    derivedFields:
      - name: trace_id
        matcherType: label
        matcherRegex: trace_id
        url: "$${__value.raw}"
        datasourceUid: tempo
        urlDisplayLabel: View trace
  secureJsonData:
    httpHeaderValue1: {{ $header | quote }}

- name: Tempo
  uid: tempo
  orgId: {{ $org }}
  type: tempo
  access: proxy
  url: http://tempo.lgtm.svc:3200
  jsonData:
    httpHeaderName1: X-Scope-OrgID
    # dashboard trace panels and Traces Drilldown stream over gRPC-over-HTTP (tempo streamOverHttpEnabled)
    streamingEnabled: { search: true, metrics: true }
    serviceMap: { datasourceUid: mimir }
    nodeGraph: { enabled: true }
    search: { hide: false }
    # span -> the logs of its whole trace, from every service, e.g. also PostgreSQL's slow query log for a
    # database span (Alloy sets trace_id from the SQL comment, examples/postgres/alloy.alloy)
    tracesToLogsV2:
      datasourceUid: loki
      spanStartTimeShift: "-5m"
      spanEndTimeShift: "5m"
      customQuery: true
      query: '{service_name=~".+"} | trace_id="${__trace.traceId}"'
    # span -> RED metrics generated by Tempo (label "service" on traces_spanmetrics_*)
    tracesToMetrics:
      datasourceUid: mimir
      spanStartTimeShift: "-5m"
      spanEndTimeShift: "5m"
      tags: [{ key: service.name, value: service }]
      queries:
        - name: Request rate
          query: sum by (span_name) (rate(traces_spanmetrics_calls_total{$$__tags}[5m]))
        - name: Error rate
          query: sum by (span_name) (rate(traces_spanmetrics_calls_total{$$__tags, status_code="STATUS_CODE_ERROR"}[5m]))
        - name: p95 latency
          query: histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{$$__tags}[5m])))
    # span -> CPU flame graph of exactly that span (span_id labels from the Pyroscope OTel extension)
    tracesToProfiles:
      datasourceUid: pyroscope
      profileTypeId: "process_cpu:cpu:nanoseconds:cpu:nanoseconds"
      tags: [{ key: service.name, value: service_name }]
  secureJsonData:
    httpHeaderValue1: {{ $header | quote }}
{{- /* Pyroscope has no cross-tenant queries: one datasource per tenant; "pyroscope" is the first tenant's. */}}
{{- $multi := gt (len .tenants) 1 }}
{{- range $i, $t := .tenants }}

- name: Pyroscope{{ if $multi }} ({{ $t }}){{ end }}
  uid: {{ if eq $i 0 }}pyroscope{{ else }}pyroscope-{{ $t }}{{ end }}
  orgId: {{ $org }}
  type: grafana-pyroscope-datasource
  access: proxy
  url: http://pyroscope.lgtm.svc:4040
  jsonData:
    httpHeaderName1: X-Scope-OrgID
  secureJsonData:
    httpHeaderValue1: {{ $t | quote }}
{{- end }}
{{- end }}
