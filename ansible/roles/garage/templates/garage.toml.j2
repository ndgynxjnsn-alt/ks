# {{ ansible_managed }}
replication_factor = 3
metadata_dir = "/var/lib/garage/meta"
data_dir = [
{% for d in garage_disks %}
  { path = "/srv/garage/data{{ loop.index }}", capacity = "{{ garage_disk_capacity }}" },
{% endfor %}
]
db_engine = "lmdb"
compression_level = 1

rpc_secret = "{{ garage_rpc_secret }}"
rpc_bind_addr = "[::]:3901"
rpc_public_addr = "{{ ansible_host }}:3901"

[s3_api]
api_bind_addr = "[::]:3900"
s3_region = "garage"
root_domain = ".s3.garage"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{ garage_admin_token }}"
metrics_token = "{{ garage_admin_token }}"
