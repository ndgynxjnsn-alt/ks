# {{ ansible_managed }}
# Client secret of the Keycloak client "{{ oauth.client_id }}" for Grafana's generic OAuth login.
apiVersion: v1
kind: Secret
metadata:
  name: grafana-oauth
  namespace: lgtm
  labels: { lgtm/set: oauth }
type: Opaque
stringData:
  client-secret: "{{ oauth_client_secret }}"
