# {{ ansible_managed }}
# Values of argocd/platform: ingress VIP, ingresses, TLS issuer, Grafana database, dashboards.
domain: "{{ domain }}"
ingressVIP: "{{ ingress_vip }}"
hosts: {{ lgtm_hosts | to_json }}
traefikSelector: {{ traefik_selector | to_json }}
tls:
  issuer: "{{ tls_issuer.name }}"
  acmeServer: "{{ tls_issuer.acme_server }}"
  email: "{{ tls_issuer.email }}"
  eabKeyID: "{{ tls_issuer.eab_kid }}"
{% if tls_issuer.ca_bundle_file and tls_issuer.ca_bundle_file is file %}
  caBundle: "{{ lookup('file', tls_issuer.ca_bundle_file) | b64encode }}"
{% endif %}
grafanaDB:
  image: "{{ grafana_db_image }}"
  instances: 3
  size: 1Gi
  external: {{ grafana_db_external | default(false) | to_json }}
  backup:
    retention: {{ grafana_db_backup_retention | default('7d') }}
    schedule: "0 0 2 * * *"
pgbackweb:
  image: "{{ pgbackweb_image }}"
s3Endpoint: "{{ s3_endpoint }}"
