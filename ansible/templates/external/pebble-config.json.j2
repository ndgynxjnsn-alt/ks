{
  "pebble": {
    "listenAddress": "0.0.0.0:14000",
    "managementListenAddress": "0.0.0.0:15000",
    "certificate": "/config/acme.crt",
    "privateKey": "/config/acme.key",
    "httpPort": 80,
    "tlsPort": 443,
    "ocspResponderURL": "",
    "externalAccountBindingRequired": true,
    "externalAccountMACKeys": {
      "{{ tls_issuer.eab_kid }}": "{{ tls_issuer.eab_hmac_key }}"
    },
    "domainBlocklist": [],
    "retryAfter": { "authz": 3, "order": 5 },
    "profiles": {
      "default": {
        "description": "7-day certificates, so cert-manager renews them (after ~5 days) in the lab",
        "validityPeriod": 604800
      }
    }
  }
}
