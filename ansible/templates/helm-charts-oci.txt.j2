# Helm charts of the LGTM cluster - sources for compliance. Generated by ansible/download.yml.
# Format: chart  version  source  [digest]
# Pull an OCI chart:  helm pull <oci-reference> --version <version>
{% for name, c in charts | dictsort %}
{%   if c.oci is defined %}
{{ name }}  {{ c.version }}  {{ c.oci }}  {{ digests[name] }}
{%   else %}
{{ name }}  {{ c.version }}  {{ c.repo }}  (no OCI publication; HTTPS repository)
{%   endif %}
{% endfor %}
mimir-distributed  {{ mimir_chart.version }}  {{ mimir_chart.repo }}#{{ mimir_chart.commit }}  (NGDATA fork, packaged from Git; upstream: oci://ghcr.io/grafana/helm-charts/mimir-distributed)
