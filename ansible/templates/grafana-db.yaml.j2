# {{ ansible_managed }}
# PostgreSQL for Grafana, run by CloudNativePG: 3 instances (one primary, two streaming replicas) spread over
# the nodes; on primary failure the operator promotes a replica and moves the -rw Service to it.
# The operator generates the credentials into Secret grafana-db-app (username, password, host, uri, ...).
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: grafana-db
  namespace: lgtm
  labels: { lgtm/set: grafana-db }
spec:
  instances: 3
  imageName: {{ grafana_db_image }}
  imagePullPolicy: IfNotPresent
  storage:
    size: 1Gi                      # local-path (default StorageClass)
  bootstrap:
    initdb:
      database: grafana
      owner: grafana
  affinity:
    enablePodAntiAffinity: true
    topologyKey: kubernetes.io/hostname
    podAntiAffinityType: required
  resources:
    requests: { cpu: 50m, memory: 128Mi }
    limits: { memory: 512Mi }
