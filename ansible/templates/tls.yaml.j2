# {{ ansible_managed }}
# One wildcard certificate *.{{ domain }} for all hostnames, from the CA via ACME with External Account
# Binding (EAB key id + HMAC key: only that external account gets certificates). Wildcards need the DNS-01
# challenge: cert-manager writes _acme-challenge.{{ domain }} TXT records with RFC2136 dynamic updates,
# authenticated by a TSIG key, into the zone on {{ tls_issuer.dns01.nameserver }}. Settings: tls_issuer.
apiVersion: v1
kind: Secret
metadata:
  name: {{ tls_issuer.name }}-eab
  namespace: cert-manager        # ClusterIssuer secrets live in cert-manager's cluster resource namespace
  labels: { lgtm/set: tls }
type: Opaque
stringData:
  hmac-key: "{{ tls_issuer.eab_hmac_key }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ tls_issuer.name }}-tsig
  namespace: cert-manager
  labels: { lgtm/set: tls }
type: Opaque
stringData:
  tsig-secret: "{{ tls_issuer.dns01.tsig_secret }}"
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ tls_issuer.name }}
  labels: { lgtm/set: tls }
spec:
  acme:
    server: {{ tls_issuer.acme_server }}
    email: {{ tls_issuer.email }}
{% if tls_issuer.ca_bundle_file and tls_issuer.ca_bundle_file is file %}
    # CA of the ACME server's own TLS certificate
    caBundle: {{ lookup('file', tls_issuer.ca_bundle_file) | b64encode }}
{% endif %}
    externalAccountBinding:
      keyID: {{ tls_issuer.eab_kid }}
      keySecretRef:
        name: {{ tls_issuer.name }}-eab
        key: hmac-key
    privateKeySecretRef:
      name: {{ tls_issuer.name }}-acme-account
    solvers:
      - dns01:
          rfc2136:
            nameserver: "{{ tls_issuer.dns01.nameserver }}"
            tsigKeyName: {{ tls_issuer.dns01.tsig_key_name }}
            tsigAlgorithm: {{ tls_issuer.dns01.tsig_algorithm }}
            tsigSecretSecretRef:
              name: {{ tls_issuer.name }}-tsig
              key: tsig-secret
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: lgtm-wildcard
  namespace: lgtm
  labels: { lgtm/set: tls }
spec:
  secretName: lgtm-wildcard-tls     # used by every https Ingress
  dnsNames: ["*.{{ domain }}", "{{ domain }}"]
  issuerRef: { kind: ClusterIssuer, name: {{ tls_issuer.name }} }
  privateKey: { algorithm: ECDSA, size: 256, rotationPolicy: Always }
