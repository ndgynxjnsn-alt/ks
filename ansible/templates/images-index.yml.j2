# {{ ansible_managed }} - generated by download.yml
# Image archive -> image reference, normalized like containerd (docker.io/[library/]...), so the nodes can
# skip archives whose image is already in containerd (ansible/roles/rke2).
{% set refs = (chart_images.stdout_lines + extra_images) | reject('match', 'lgtm.local/') | unique %}
{% for ref in refs + [grafana_image] %}
{%   set first = ref.split('/')[0] %}
{%   if '/' in ref and (first is search('[.:]') or first == 'localhost') %}
{%     set full = ref %}
{%   elif '/' in ref %}
{%     set full = 'docker.io/' ~ ref %}
{%   else %}
{%     set full = 'docker.io/library/' ~ ref %}
{%   endif %}
- { file: "{{ ref | regex_replace('[/:@]', '_') }}.tar.zst", ref: "{{ full }}" }
{% endfor %}
