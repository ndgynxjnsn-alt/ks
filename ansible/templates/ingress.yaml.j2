# {{ ansible_managed }}
# Every hostname <name>.{{ domain }} twice: plain http on Traefik's "web" entrypoint, and https on
# "websecure" with the wildcard certificate *.{{ domain }} (Secret lgtm-wildcard-tls, templates/tls.yaml.j2).
# (One Ingress with a tls: block would make Traefik serve that host on https only.)
{% set routes = {
  'grafana':   [('/', 'grafana', 80)],
  'loki':      [('/', 'loki', 3100)],
  'tempo':     [('/', 'tempo', 3200)],
  'mimir':     [('/', 'mimir-monolithic', 8080)],
  'pyroscope': [('/', 'pyroscope', 4040)],
  'alloy':     [('/v1/', 'alloy', 4318), ('/ingest', 'alloy', 9999), ('/', 'alloy', 12345)],
  'garage':    [('/', 'garage', 3900)],
} %}
{# only hostnames listed in lgtm_hosts (removing one there removes its ingresses) #}
{% for name, paths in routes.items() if name in lgtm_hosts %}
{% for scheme in ['http', 'https'] %}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ name }}-{{ scheme }}
  namespace: lgtm
  labels: { lgtm/set: ingress }
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: {{ 'web' if scheme == 'http' else 'websecure' }}
spec:
  ingressClassName: traefik
{% if scheme == 'https' %}
  tls:
    - hosts: ["{{ name }}.{{ domain }}"]
      secretName: lgtm-wildcard-tls
{% endif %}
  rules:
    - host: {{ name }}.{{ domain }}
      http:
        paths:
{% for path, svc, port in paths %}
          - path: {{ path }}
            pathType: Prefix
            backend: { service: { name: {{ svc }}, port: { number: {{ port }} } } }
{% endfor %}
{% endfor %}
{% endfor %}
