# {{ ansible_managed }}
# One LoadBalancer Service per hostname, each with its own floating IP (kube-vip, per-service leader election).
# All hostnames lead to Traefik (http 80 + https 443), which routes by Host header (templates/ingress.yaml.j2).
# externalTrafficPolicy
# Local: traffic is served by the Traefik pod on the node that currently holds the IP (no extra hop).
apiVersion: v1
kind: Namespace
metadata:
  name: lgtm
{% for name, v in service_vips.items() %}
---
apiVersion: v1
kind: Service
metadata:
  name: vip-{{ name }}
  namespace: kube-system
  labels: { lgtm/set: vips }
  annotations:
    kube-vip.io/loadbalancerIPs: "{{ v.ip }}"
    lgtm/hostname: {{ v.host }}
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local
  selector: {{ traefik_selector | to_json }}
  ports:
    - { name: web, port: 80, targetPort: web }
    - { name: websecure, port: 443, targetPort: websecure }
{% endfor %}
---
# Garage runs on the nodes, outside Kubernetes: a Service without selector whose endpoints are the nodes.
# In-cluster S3 endpoint {{ s3_endpoint }}; from outside via Traefik as {{ service_vips.garage.host }}.
apiVersion: v1
kind: Service
metadata:
  name: garage
  namespace: lgtm
  labels: { lgtm/set: vips }
spec:
  ports:
    - { name: s3, port: 3900 }
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: garage-nodes
  namespace: lgtm
  labels:
    kubernetes.io/service-name: garage
    lgtm/set: vips
addressType: IPv4
ports:
  - { name: s3, port: 3900, protocol: TCP }
endpoints:
{% for host in groups['nodes'] %}
  - addresses: ["{{ hostvars[host].ansible_host }}"]
{% endfor %}
