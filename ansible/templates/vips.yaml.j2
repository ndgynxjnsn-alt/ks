# {{ ansible_managed }}
# The floating IP for everything LGTM: one LoadBalancer Service (kube-vip, address from the
# kube-vip.io/loadbalancerIPs annotation) in front of Traefik, which routes *.{{ domain }} by Host header
# (templates/ingress.yaml.j2). externalTrafficPolicy Local: the Traefik pod on the node that holds the IP
# serves the traffic. The Kubernetes API has its own VIP {{ vip }} (kube-vip control plane mode).
apiVersion: v1
kind: Namespace
metadata:
  name: lgtm
---
apiVersion: v1
kind: Service
metadata:
  name: vip-ingress
  namespace: kube-system
  labels: { lgtm/set: vips }
  annotations:
    kube-vip.io/loadbalancerIPs: "{{ ingress_vip }}"
spec:
  type: LoadBalancer
  externalTrafficPolicy: Local
  selector: {{ traefik_selector | to_json }}
  ports:
    - { name: web, port: 80, targetPort: web }
    - { name: websecure, port: 443, targetPort: websecure }
---
# Garage runs on the nodes, outside Kubernetes: a Service without selector whose endpoints are the nodes.
# In-cluster S3 endpoint {{ s3_endpoint }}; from outside via Traefik as garage.{{ domain }}.
apiVersion: v1
kind: Service
metadata:
  name: garage
  namespace: lgtm
  labels: { lgtm/set: vips }
spec:
  ports:
    - { name: s3, port: 3900 }
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: garage-nodes
  namespace: lgtm
  labels:
    kubernetes.io/service-name: garage
    lgtm/set: vips
addressType: IPv4
ports:
  - { name: s3, port: 3900, protocol: TCP }
endpoints:
{% for host in groups['nodes'] %}
  - addresses: ["{{ hostvars[host].ansible_host }}"]
{% endfor %}
