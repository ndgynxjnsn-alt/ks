# {{ ansible_managed }}
# Everything secret is created here by Ansible, never stored in Git: the values in Git (k8s/values,
# argocd/) only reference these Secrets. Namespaces are created up front so the Secrets can exist before
# Argo CD deploys the apps that use them (headlamp: its Ingress comes from argocd/platform, an earlier wave).
{% for ns in ['lgtm', 'cert-manager', 'cnpg-system', 'argocd', 'headlamp'] %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
{% endfor %}
---
# S3 (Garage) credentials for Loki, Mimir, Tempo, Pyroscope (environment, -config.expand-env)
apiVersion: v1
kind: Secret
metadata: { name: s3-credentials, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  S3_ACCESS_KEY_ID: "{{ s3_access_key_id }}"
  S3_SECRET_ACCESS_KEY: "{{ s3_secret_access_key }}"
  S3_REGION: garage
---
# Garage's metrics_token, for Alloy's scrape of the Garage admin API (cluster health)
apiVersion: v1
kind: Secret
metadata: { name: garage-metrics, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  token: "{{ garage_admin_token }}"
---
apiVersion: v1
kind: Secret
metadata: { name: grafana-admin, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  admin-user: admin
  admin-password: "{{ grafana_admin_password }}"
{% if oauth.enabled %}
---
# Client secret of the OAuth client "{{ oauth.client_id }}" for Grafana's generic OAuth login
apiVersion: v1
kind: Secret
metadata: { name: grafana-oauth, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  client-secret: "{{ oauth_client_secret }}"
{% endif %}
{% if oauth.enabled and oauth.argocd_client_id is defined %}
---
# Client secret of the OAuth client "{{ oauth.argocd_client_id }}" for Argo CD's OIDC login
# (oidc.config: $argocd-oidc:client-secret; Argo CD only reads Secrets labelled part-of: argocd)
apiVersion: v1
kind: Secret
metadata:
  name: argocd-oidc
  namespace: argocd
  labels: { lgtm/set: secrets, app.kubernetes.io/part-of: argocd }
type: Opaque
stringData:
  client-secret: "{{ argocd_oauth_client_secret }}"
{% endif %}
---
# PostgreSQL role "pgbackweb" (CloudNativePG managed role) and PG Back Web's key for the credentials it stores
apiVersion: v1
kind: Secret
metadata: { name: pgbackweb-db, namespace: lgtm, labels: { lgtm/set: secrets, cnpg.io/reload: "true" } }
type: kubernetes.io/basic-auth
stringData:
  username: pgbackweb
  password: "{{ pgbackweb_db_password }}"
---
apiVersion: v1
kind: Secret
metadata: { name: pgbackweb, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  encryption-key: "{{ pgbackweb_encryption_key }}"
---
# ACME External Account Binding HMAC key (ClusterIssuer secrets live in cert-manager's namespace)
apiVersion: v1
kind: Secret
metadata: { name: "{{ tls_issuer.name }}-eab", namespace: cert-manager, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  hmac-key: "{{ tls_issuer.eab_hmac_key }}"
{% if gitops.repo_username is defined %}
---
# Credentials for Argo CD to read the Git repository
apiVersion: v1
kind: Secret
metadata:
  name: lgtm-git-repo
  namespace: argocd
  labels: { lgtm/set: secrets, argocd.argoproj.io/secret-type: repository }
stringData:
  type: git
  url: "{{ gitops.repo_url }}"
  username: "{{ gitops.repo_username }}"
  password: "{{ gitops.repo_password }}"
{% endif %}
{% if gitops.helm_username is defined %}
---
# Credentials for Argo CD to read the Helm repository
apiVersion: v1
kind: Secret
metadata:
  name: lgtm-helm-repo
  namespace: argocd
  labels: { lgtm/set: secrets, argocd.argoproj.io/secret-type: repository }
stringData:
  type: helm
  name: lgtm
  url: "{{ gitops.helm_repo_url }}"
  username: "{{ gitops.helm_username }}"
  password: "{{ gitops.helm_password }}"
{% endif %}
