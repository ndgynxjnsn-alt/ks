# {{ ansible_managed }}
# Everything secret is created here by Ansible, never stored in Git: the values in Git (k8s/values,
# argocd/) only reference these Secrets. Namespaces are created up front so the Secrets can exist before
# Argo CD deploys the apps that use them.
{% for ns in ['lgtm', 'cert-manager', 'cnpg-system', 'argocd'] %}
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ ns }}
{% endfor %}
---
# S3 (Garage) credentials for Loki, Mimir, Tempo, Pyroscope (environment, -config.expand-env)
apiVersion: v1
kind: Secret
metadata: { name: s3-credentials, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  S3_ACCESS_KEY_ID: "{{ s3_access_key_id }}"
  S3_SECRET_ACCESS_KEY: "{{ s3_secret_access_key }}"
---
# Garage's metrics_token, for Alloy's scrape of the Garage admin API (cluster health)
apiVersion: v1
kind: Secret
metadata: { name: garage-metrics, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  token: "{{ garage_admin_token }}"
---
apiVersion: v1
kind: Secret
metadata: { name: grafana-admin, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  admin-user: admin
  admin-password: "{{ grafana_admin_password }}"
{% if oauth.enabled %}
---
# Client secret of the OAuth client "{{ oauth.client_id }}" for Grafana's generic OAuth login
apiVersion: v1
kind: Secret
metadata: { name: grafana-oauth, namespace: lgtm, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  client-secret: "{{ oauth_client_secret }}"
{% endif %}
---
# ACME External Account Binding HMAC key (ClusterIssuer secrets live in cert-manager's namespace)
apiVersion: v1
kind: Secret
metadata: { name: "{{ tls_issuer.name }}-eab", namespace: cert-manager, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  hmac-key: "{{ tls_issuer.eab_hmac_key }}"
---
# TSIG key for RFC2136 updates of the DNS-01 challenge records
apiVersion: v1
kind: Secret
metadata: { name: "{{ tls_issuer.name }}-tsig", namespace: cert-manager, labels: { lgtm/set: secrets } }
type: Opaque
stringData:
  tsig-secret: "{{ tls_issuer.dns01.tsig_secret }}"
{% if gitops.repo_username is defined %}
---
# Credentials for Argo CD to read the Git repository
apiVersion: v1
kind: Secret
metadata:
  name: lgtm-git-repo
  namespace: argocd
  labels: { lgtm/set: secrets, argocd.argoproj.io/secret-type: repository }
stringData:
  type: git
  url: "{{ gitops.repo_url }}"
  username: "{{ gitops.repo_username }}"
  password: "{{ gitops.repo_password }}"
{% endif %}
{% if gitops.helm_username is defined %}
---
# Credentials for Argo CD to read the Helm repository
apiVersion: v1
kind: Secret
metadata:
  name: lgtm-helm-repo
  namespace: argocd
  labels: { lgtm/set: secrets, argocd.argoproj.io/secret-type: repository }
stringData:
  type: helm
  name: lgtm
  url: "{{ gitops.helm_repo_url }}"
  username: "{{ gitops.helm_username }}"
  password: "{{ gitops.helm_password }}"
{% endif %}
