# ansible-lint configuration (run: uvx --from ansible-lint ansible-lint)
profile: production
exclude_paths:
  - artifacts/
  - .bin/
  - lab/external/.generated/
  - argocd/          # Helm charts (Go templates), not Ansible
  - certs/           # Helm chart
  - k8s/             # Helm values / Kubernetes manifests
  - apps/
