# Telemetry settings of the demo app (OTel Java agent, Pyroscope agent). Kustomize turns this into the
# ConfigMap telemetry-<hash>, so every change here rolls the pods.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.lgtm.svc:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=X-Scope-OrgID=demo
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_INSTRUMENTATION_MICROMETER_ENABLED=true
OTEL_INSTRUMENTATION_LOGBACK_APPENDER_EXPERIMENTAL_LOG_ATTRIBUTES=true
PYROSCOPE_SERVER_ADDRESS=http://alloy.lgtm.svc:9999
PYROSCOPE_FORMAT=jfr
PYROSCOPE_PROFILER_EVENT=itimer
PYROSCOPE_PROFILER_ALLOC=512k
PYROSCOPE_PROFILER_LOCK=10ms
PYROSCOPE_UPLOAD_INTERVAL=15s
PYROSCOPE_LABELS=deployment_environment_name=lab,tenant=demo
OTEL_PYROSCOPE_START_PROFILING=false
OTEL_PYROSCOPE_ADD_PROFILE_URL=false
OTEL_PYROSCOPE_ADD_PROFILE_BASELINE_URL=false
