# yamllint (also used by ansible-lint's yaml rule)
extends: default
rules:
  line-length: { max: 120 }
  document-start: disable
  truthy: { allowed-values: ["true", "false"], check-keys: false }
  comments: { min-spaces-from-content: 1 }
  comments-indentation: false
  braces: { max-spaces-inside: 1 }
  octal-values: { forbid-implicit-octal: true, forbid-explicit-octal: true }
ignore: |
  artifacts/
  .bin/
  lab/external/.generated/
  argocd/*/templates/
  certs/templates/
